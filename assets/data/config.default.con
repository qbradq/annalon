# Player configuration script for Annalon

# Standard aliases
alias exit quit

# Standard binds
bind "w" "+forward"
bind "s" "+backward"
bind "a" "+left"
bind "d" "+right"
bind "left" "+turn_left"
bind "right" "+turn_right"
bind "up" "+look_up"
bind "down" "+look_down"
bind "space" "+jump"
bind "ctrl" "+crouch"
bind "shift" "+sprint"
bind "esc" "toggle_menu"
